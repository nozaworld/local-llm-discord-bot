# このファイルをコピーして .env を作成し、値を埋めてください
#   cp .env.example .env

# 必須: Discord Botのトークン（Discord Developer Portalで発行）
DISCORD_BOT_TOKEN=

# 以下は任意（未設定の場合は既定値が使われます。config.py参照）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:12B
# OLLAMA_EMBED_MODEL=nomic-embed-text
# DOCS_DIRECTORY=.
# DOCS_INCLUDE_DIRS=minutes   # 指定するとこのフォルダだけを読み込み対象にする（推奨）
# DOCS_EXCLUDE_DIRS=myenv,.venv,venv,__pycache__,.git,node_modules,private,data,_to_delete   # DOCS_INCLUDE_DIRS未指定時のみ有効
# MASCOT_NAME=ミーティー
# MASCOT_PERSONA=元気で丁寧。会議の合意事項とTODOを必ず要約する癖がある。
# MASCOT_ENDING=
# CONVERSATION_HISTORY_TURNS=6
# ASK_COOLDOWN_SECONDS=20
# CHAT_COOLDOWN_SECONDS=10
# RAG_TOP_K=4
# RAG_CHUNK_CHARS=800
